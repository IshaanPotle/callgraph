# Leave unset to run the whole pipeline offline against the deterministic
# simulator (LLM_PROVIDER=stub). Set it to run the same code against Claude.
ANTHROPIC_API_KEY=

# stub | anthropic   (default: anthropic if a key is present, else stub)
LLM_PROVIDER=

# Model used in live mode.
CALLGRAPH_MODEL=claude-opus-5

# Effort for the heavier reasoning agents (low | medium | high | xhigh | max).
CALLGRAPH_EFFORT=high

# Max concurrent in-flight model calls.
CALLGRAPH_CONCURRENCY=8
